{
  "name": "@heluo/forge-iam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise IAM exclusive sign-in for DeepSeek Harness",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./model-gate": "./src/model-gate.mjs",
    "./isolated-testing": "./src/isolated-testing.mjs"
  },
  "files": [
    "src",
    "bin",
    "client.js",
    "locale",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "bin": {
    "heluo-forge": "./bin/heluo-forge.mjs"
  },
  "dependencies": {
    "@heluo/forge-credentials-keychain": "workspace:*"
  }
}
