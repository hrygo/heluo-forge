{
  "name": "@heluo/forge-devops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "icon": "./icon.svg",
  "description": "Enterprise DevOps host plugin for Heluo Forge: change flow queries, controlled updates, fixed argv adapters, and CLI configuration settings",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@heluo/forge-policy": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./client.js",
    "./read": "./src/read.mjs",
    "./runtime-config": "./src/runtime-config.mjs",
    "./cli-runner": "./src/cli-runner.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "locale"
      ]
    }
  }
}
