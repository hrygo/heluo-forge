{
  "name": "@heluo/forge-experts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "icon": "./icon.svg",
  "description": "Standalone DSH expert agent management plugin for Heluo Forge",
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "scripts": {
    "test": "node --test"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
