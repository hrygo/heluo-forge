{
  "name": "@heluo/forge-gitee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gitee change-flow host plugin for Heluo Forge: gitee.* read queries, policy-gated controlled writes and review/delivery judgement, isolated from the GitHub (forge-devops) semantics",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@heluo/forge-policy": "workspace:*"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./runtime-config": "./src/runtime-config.mjs",
    "./read": "./src/gitee-read.mjs",
    "./actions": "./src/gitee-actions.mjs",
    "./adapter": "./src/gitee-adapter.mjs"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
