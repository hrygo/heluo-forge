{
  "name": "@heluo/forge-gitee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "icon": "./icon.svg",
  "description": "Enterprise Gitee integration for Heluo Forge: repository/Issue/PR queries, controlled writes, delivery judgement, gated local git commit/push, and settings panel",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@heluo/forge-policy": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./runtime-config": "./src/runtime-config.mjs",
    "./read": "./src/gitee-read.mjs",
    "./actions": "./src/gitee-actions.mjs",
    "./adapter": "./src/gitee-adapter.mjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "locale"
      ]
    }
  }
}
