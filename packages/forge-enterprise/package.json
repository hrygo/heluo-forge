{
  "name": "@heluo/forge-enterprise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise bundle composition helpers for Heluo Forge",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@heluo/forge-credentials-keychain": "workspace:*",
    "@heluo/forge-devops": "workspace:*",
    "@heluo/forge-gitee": "workspace:*",
    "@heluo/forge-iam": "workspace:*",
    "@heluo/forge-policy": "workspace:*"
  },
  "bundledDependencies": [
    "@heluo/forge-credentials-keychain",
    "@heluo/forge-devops",
    "@heluo/forge-gitee",
    "@heluo/forge-iam",
    "@heluo/forge-policy"
  ],
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json",
    "./skills": "./src/skills.mjs",
    "./switches": "./src/switches.mjs",
    "./reflow": "./src/reflow.mjs",
    "./issue-delivery-skill": "./src/issue-delivery-skill.mjs",
    "./issue-delivery-skill/locale/*.json": "./locale/*.json",
    "./issue-delivery-skill/icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "skills",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
