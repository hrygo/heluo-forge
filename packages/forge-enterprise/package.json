{
  "name": "@heluo/forge-enterprise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Universal enterprise identity, AI gateway, model catalog, and encrypted keychain base bundle for DeepSeek Harness",
  "icon": "./icon.svg",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@heluo/forge-credentials-keychain": "workspace:*",
    "@heluo/forge-iam": "workspace:*",
    "@heluo/forge-policy": "workspace:*"
  },
  "bundledDependencies": [
    "@heluo/forge-credentials-keychain",
    "@heluo/forge-iam",
    "@heluo/forge-policy"
  ],
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json",
    "./reflow": "./src/reflow.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
