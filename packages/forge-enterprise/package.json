{
  "name": "@heluo/forge-enterprise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise bundle composition helpers for Heluo Forge",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@heluo/forge-credentials-keychain": "workspace:*",
    "@heluo/forge-policy": "workspace:*",
    "@heluo/forge-iam": "workspace:*",
    "@heluo/forge-sdd": "workspace:*",
    "@heluo/forge-devops": "workspace:*"
  },
  "bundledDependencies": [
    "@heluo/forge-credentials-keychain",
    "@heluo/forge-policy",
    "@heluo/forge-iam",
    "@heluo/forge-sdd",
    "@heluo/forge-devops"
  ],
  "bin": {
    "forge-sdd": "./src/sdd-cli.mjs",
    "heluo-change": "./src/change-cli.mjs"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./skills": "./src/skills.mjs",
    "./switches": "./src/switches.mjs",
    "./reflow": "./src/reflow.mjs"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
