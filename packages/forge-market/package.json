{
  "name": "@heluo/forge-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Point the DSH plugin market at the enterprise registry and enforce install policy",
  "engines": {
    "dsh": ">=0.2.1"
  },
  "scripts": {
    "test": "node --test"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./client.js"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
