{
  "info": {
    "name": "Heluo Forge loopback API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Success",
      "request": { "method": "GET", "url": "{{base}}/api" },
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('response is successful', () => pm.response.to.have.status(200))", "pm.test('body reports success', () => pm.expect(pm.response.json().ok).to.be.true)"] } }
      ]
    },
    {
      "name": "Unknown route",
      "request": { "method": "GET", "url": "{{base}}/missing" },
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('unknown route is rejected', () => pm.response.to.have.status(404))", "pm.test('body reports failure', () => pm.expect(pm.response.json().ok).to.be.false)"] } }
      ]
    }
  ]
}
