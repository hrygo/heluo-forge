{
  "name": "heluo-forge",
  "version": "0.0.0",
  "private": true,
  "description": "河洛（Heluo Forge）融合企业级智能研发平台与智能个人助理的方案与扩展工程，基于 DeepSeek Harness 构建",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "check": "node scripts/link-workspace.mjs && node --run check:skills-manager && node scripts/check-docs.mjs && node scripts/check-repo.mjs && node scripts/check-skills.mjs && node scripts/check-bundle-tarballs.mjs && node scripts/dsh-version.mjs check && node --test --test-timeout=120000",
    "check:docs": "node scripts/check-docs.mjs",
    "docs:catalog": "node scripts/check-docs.mjs --catalog",
    "link:workspace": "node scripts/link-workspace.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "test:unit": "node --test --test-timeout=120000",
    "check:tarballs": "node scripts/check-bundle-tarballs.mjs",
    "check:version": "node scripts/dsh-version.mjs check",
    "sensitive:scan": "node scripts/sensitive-scan/scan.mjs",
    "sensitive:install": "node scripts/sensitive-scan/install-hook.mjs",
    "sensitive:keygen": "node scripts/sensitive-scan/keygen.mjs",
    "sensitive:verify": "node scripts/sensitive-scan/verify.mjs",
    "build:enterprise": "node scripts/build-enterprise-bundle.mjs",
    "build:engineering": "node scripts/build-enterprise-bundle.mjs --entry @heluo/forge-engineering",
    "verify:bundle": "node scripts/verify-enterprise-bundle.mjs",
    "uninstall:devops": "node scripts/uninstall-devops.mjs",
    "check:skills-manager": "node packages/forge-skills-manager/scripts/check-generated.mjs && node packages/forge-skills-manager/node_modules/typescript/bin/tsc --noEmit -p packages/forge-skills-manager/tsconfig.json"
  }
}
