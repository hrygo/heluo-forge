{
  "name": "heluo-forge",
  "version": "0.0.0",
  "private": true,
  "description": "河洛（Heluo Forge）融合企业级智能研发平台与智能个人助理的方案与扩展工程，基于 DeepSeek Harness 构建",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "check": "node scripts/link-workspace.mjs && node scripts/check-docs.mjs && node scripts/check-repo.mjs && node scripts/check-skills.mjs && node scripts/check-bundle-tarballs.mjs && node scripts/dsh-version.mjs check && node --test",
    "check:docs": "node scripts/check-docs.mjs",
    "link:workspace": "node scripts/link-workspace.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "test:unit": "node --test",
    "check:tarballs": "node scripts/check-bundle-tarballs.mjs",
    "check:version": "node scripts/dsh-version.mjs check",
    "sensitive:scan": "node scripts/sensitive-scan/scan.mjs",
    "sensitive:install": "node scripts/sensitive-scan/install-hook.mjs",
    "sensitive:keygen": "node scripts/sensitive-scan/keygen.mjs",
    "sensitive:verify": "node scripts/sensitive-scan/verify.mjs",
    "build:enterprise": "node scripts/build-enterprise-bundle.mjs",
    "verify:bundle": "node scripts/verify-enterprise-bundle.mjs",
    "uninstall:devops": "node scripts/uninstall-devops.mjs"
  }
}
