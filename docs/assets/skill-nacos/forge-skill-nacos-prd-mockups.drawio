        <mxCell id="sct" parent="1" style="text;fontSize=11;align=left;whiteSpace=wrap;html=1;" value="&lt;b&gt;目录同步状态&lt;/b&gt;" vertex="1">
          <mxGeometry height="18" width="200" x="52" y="318" as="geometry" />
        </mxCell>
        <mxCell id="scb" parent="1" style="text;fontSize=10;fontColor=#666666;align=left;whiteSpace=wrap;html=1;" value="上次同步：10-27 09:41（3 分钟前）　　可见条目：12　　状态：正常&lt;br&gt;失败时：保留上次目录并标注「过期」，已安装技能不受影响，安装/更版暂不可用。" vertex="1">
