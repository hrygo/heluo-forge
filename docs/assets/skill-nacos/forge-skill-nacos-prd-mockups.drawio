          <mxGeometry height="26" width="80" x="500" y="344" as="geometry" />
        </mxCell>
        <mxCell id="warn" parent="1" style="fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacing=8;whiteSpace=wrap;html=1;" value="⚠ 无法连接技能源：检查网络或凭据 [重试] [去配置凭据]　——　已安装技能仍可离线使用，本地目录不受影响" vertex="1">
          <mxGeometry height="30" width="760" x="20" y="416" as="geometry" />
        </mxCell>
        <mxCell id="nb" parent="1" style="fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;align=left;verticalAlign=top;spacing=6;fontSize=10;whiteSpace=wrap;html=1;" value="交互规则&lt;br&gt;① 页面权限边界：地址 / Namespace / 目录模式为管理员配置项，页面只读展示；用户专属可写操作仅「凭据录入」与「立即刷新 / 暂停刷新」。&lt;br&gt;② 未配置凭据时页面顶部呈现明确的未配置状态与录入引导（fail loud），搜索/安装入口给出可行动错误，不静默空白。&lt;br&gt;③ 凭据只显示配置状态（来源 / 可写性），任何界面不回显值；修改走 DSH 原生凭据面（企业钥匙串）。&lt;br&gt;④ 退出或切换身份后目录缓存清空，页面回到未同步态；不跨身份复用目录。&lt;br&gt;⑤ agent（模型）没有任何工具能修改本页内容 —— 本页所有变更都是用户手工操作。" vertex="1">
          <mxGeometry height="112" width="760" x="20" y="462" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
