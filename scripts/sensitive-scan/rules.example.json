{
  "version": 1,
  "exclude": "(^|/)(node_modules|dist|\\.git)(/|$)",
  "rules": [
    {
      "id": "private-key-block",
      "description": "Private key marker",
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
      "flags": "g",
      "severity": "critical"
    },
    {
      "id": "generic-assignment-secret",
      "description": "Synthetic example: long value assigned to a secret-like key",
      "pattern": "\\b(?:password|passwd|secret|token|api[_-]?key)\\s*[:=]\\s*['\"]?[A-Za-z0-9_./+=-]{16,}",
      "flags": "gi",
      "severity": "high"
    },
    {
      "id": "documentation-test-ip",
      "description": "Synthetic example: TEST-NET addresses that should not appear in production config",
      "pattern": "\\b(?:192\\.0\\.2|198\\.51\\.100|203\\.0\\.113)\\.\\d{1,3}\\b",
      "flags": "g",
      "severity": "low"
    }
  ]
}
