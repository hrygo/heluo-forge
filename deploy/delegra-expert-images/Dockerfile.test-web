# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM node_toolchain AS tools
WORKDIR /out
COPY tooling/test-web/package.json tooling/test-web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM node_toolchain AS browsers
ARG CHROMIUM_URL
ARG CHROMIUM_SHA256
ARG HEADLESS_URL
ARG HEADLESS_SHA256
ARG FFMPEG_URL
ARG FFMPEG_SHA256
COPY debian.sources /etc/apt/sources.list.d/debian.sources
RUN apt-get -o Acquire::Retries=3 -o APT::Update::Error-Mode=any update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/*
ADD --checksum=sha256:${CHROMIUM_SHA256} ${CHROMIUM_URL} /tmp/chromium.zip
ADD --checksum=sha256:${HEADLESS_SHA256} ${HEADLESS_URL} /tmp/headless.zip
ADD --checksum=sha256:${FFMPEG_SHA256} ${FFMPEG_URL} /tmp/ffmpeg.zip
RUN mkdir /out \
    && unzip -q /tmp/chromium.zip -d /out/chromium-1255 \
    && unzip -q /tmp/headless.zip -d /out/chromium_headless_shell-1255 \
    && unzip -q /tmp/ffmpeg.zip -d /out/ffmpeg-1013 \
    && chmod -R a+rX /out

FROM expert_base
USER 0
# Chromium's Debian 13 dependencies from the locked Playwright version.
RUN apt-get -o Acquire::Retries=3 -o APT::Update::Error-Mode=any update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        fonts-liberation fonts-noto-color-emoji fonts-wqy-zenhei \
        libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 \
        libcairo2 libcups2t64 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0t64 \
        libnspr4 libnss3 libpango-1.0-0 libx11-6 libxcb1 libxcomposite1 \
        libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=tools /out/ /opt/expert-tools/test-web/
COPY --from=browsers /out/ /opt/playwright/
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright \
    PATH="/opt/expert-tools/test-web/node_modules/.bin:${PATH}"
USER 1000:1000
RUN /opt/playwright/chromium-1255/chrome-linux-arm64/chrome --version | grep -F '159.0.8154.6' \
    && test -x /opt/playwright/chromium_headless_shell-1255/chrome-headless-shell-linux-arm64/chrome-headless-shell \
    && test -x /opt/playwright/ffmpeg-1013/ffmpeg-linux
