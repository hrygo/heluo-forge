# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM download_base AS tools
ARG TOFU_URL
ARG TOFU_SHA256
USER 0
ADD --checksum=sha256:${TOFU_SHA256} ${TOFU_URL} /tmp/tofu.tar.gz
RUN mkdir /out && tar -xzf /tmp/tofu.tar.gz -C /out

FROM expert_base
COPY --from=tools /out/tofu /usr/local/bin/tofu
COPY --from=tools /out/LICENSE /usr/share/doc/opentofu/LICENSE
