# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM download_base AS tools
ARG K6_URL
ARG K6_SHA256
USER 0
ADD --checksum=sha256:${K6_SHA256} ${K6_URL} /tmp/k6.tar.gz
RUN mkdir /out && tar -xzf /tmp/k6.tar.gz --strip-components=1 -C /out

FROM expert_base
COPY --from=tools /out/k6 /usr/local/bin/k6
