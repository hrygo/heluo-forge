# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM node_toolchain AS tools
WORKDIR /out
COPY tooling/test-api/package.json tooling/test-api/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM expert_base
COPY --from=tools /out/ /opt/expert-tools/test-api/
ENV PATH="/opt/expert-tools/test-api/node_modules/.bin:${PATH}"
