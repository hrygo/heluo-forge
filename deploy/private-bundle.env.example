# ==============================================================================
# 河洛 (Heluo Forge) 企业私版打包配置模板 (deploy/private-bundle.env.example)
# ==============================================================================
# 用法：
#   1. 复制为仓库根目录的 .env（受 .gitignore 忽略）：cp deploy/private-bundle.env.example .env && chmod 600 .env
#   2. 按企业实际环境修改值后，传给制包脚本：
#      node scripts/release-delivery.mjs --public <tgz> --public-sha256 <hex> \
#        --config .env --version <x.y.z> --output <dir> --dry-run
#
# 解析规则（scripts/lib/private-bundle.mjs）：
#   - 仅按纯数据解析 KEY=VALUE：禁止 export、命令替换 $(...)、变量展开 ${...} 与反引号。
#   - 未知键会直接报 CONFIG_UNKNOWN_KEY，请勿自行新增未登记的 HELUO_* 键。
#   - 严禁将真实企业内网地址、密钥或个人令牌提交到本模板文件。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IAM 认证模式与客户端凭据（必填 / 企业目标部署）
# ------------------------------------------------------------------------------

# 认证模式：confidential（企业目标部署必填）| public（仅兼容无认证换票/刷新的部署）
HELUO_IAM_AUTH_MODE=confidential

# 客户端认证方法（confidential 必填，须与 IAM 登记的 token_endpoint_auth_method 一致）：
# 可选值：client_secret_basic | client_secret_post（public 模式仅允许 none 或省略）
HELUO_IAM_CLIENT_AUTH_METHOD=client_secret_basic

# 客户端密钥引用（confidential 必填）：非秘密标识，匹配 ^[a-z][a-z0-9-]*$
# 必须与终端管理员预置到本机加密存储时的引用名一致；public 模式禁止设置此项
HELUO_IAM_CLIENT_SECRET_REF=corp-iam-client-secret

# 在 IAM 管理台登记的应用 client_id（必填）
HELUO_IAM_CLIENT_ID=dsh-desktop

# ------------------------------------------------------------------------------
# 2. IAM 端点发现（二选一：优先使用 Discovery URL）
# ------------------------------------------------------------------------------

# [方式 A - 推荐] OIDC Discovery 文档地址
# 注意：启用本项时，禁止同时设置 HELUO_IAM_ISSUER（issuer 由 Discovery 文档自动提供）
HELUO_IAM_DISCOVERY_URL=https://iam.corp.example/.well-known/openid-configuration

# [方式 B - 显式端点] 仅在无法访问 Discovery 时启用；必须同时取消以下 4 项注释：
# HELUO_IAM_ISSUER=https://iam.corp.example
# HELUO_IAM_AUTHORIZATION_ENDPOINT=https://iam.corp.example/oauth2/authorize
# HELUO_IAM_TOKEN_ENDPOINT=https://iam.corp.example/oauth2/token
# HELUO_IAM_JWKS_URI=https://iam.corp.example/oauth2/jwks

# ------------------------------------------------------------------------------
# 3. 授权范围、撤销、登出与用户画像
# ------------------------------------------------------------------------------

# 授权范围（空格或逗号分隔，必须包含 openid）。
# IAM 6.0.3 换票直接返回 refresh_token 且不要求 offline_access，显式收敛为 openid profile
HELUO_IAM_SCOPES=openid profile

# 访问令牌撤销端点（D1 GET 撤销方式，用于退出登录时注销远端会话；按实际需要填写）
HELUO_IAM_REVOCATION_ENDPOINT=https://iam.corp.example/oauth2/revoke

# RP 全局登出端点（可选，用于 logoutMode=rp 时生成全局登出地址）
# HELUO_IAM_END_SESSION_ENDPOINT=https://iam.corp.example/oauth2/logout

# UserInfo 端点（可选；Discovery 未返回或显式端点模式下需要获取工号/姓名时填写）
# HELUO_IAM_USERINFO_ENDPOINT=https://iam.corp.example/oauth2/userinfo

# UserInfo 字段映射（可选，仅在 IAM 团队书面确认字段口径后取消注释填写）
# 格式为 键=claim 逗号分隔，键仅允许 workNo / name，禁止重复键；未配置时不请求 UserInfo
# HELUO_IAM_PROFILE_FIELDS=workNo=work_no,name=pinyin

# ------------------------------------------------------------------------------
# 4. 本地回环回调配置
# ------------------------------------------------------------------------------

# 回环监听地址：auto（优先 127.0.0.1，缺失时回退 ::1）| 127.0.0.1 | ::1（禁止 localhost）
HELUO_IAM_CALLBACK_ADDRESS=auto

# 回环监听端口：0（系统动态分配，推荐配合前缀登记）| 1024-65535（仅精确匹配固定端口时使用）
HELUO_IAM_CALLBACK_PORT=0

# 回调路径（可选，默认 /iam/callback；须以 / 开头，不能为 / 或 /api/forge-iam*）
HELUO_IAM_REDIRECT_PATH=/iam/callback

# 登出后回跳地址（可选）
# HELUO_IAM_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:18080/logout-done

# ------------------------------------------------------------------------------
# 5. 企业模型网关配置
# ------------------------------------------------------------------------------

# 企业模型网关 Base URL（通常以 /v1 结尾，默认仅允许 https://）
HELUO_IAM_MANAGED_MODELS_BASE_URL=https://gateway.corp.example/v1

# 默认模型路由 Provider ID（配置网关时必填，匹配 ^[a-zA-Z0-9][a-zA-Z0-9._-]*$）
HELUO_IAM_DEFAULT_PROVIDER=enterprise

# 默认模型 ID（可选）
HELUO_IAM_DEFAULT_MODEL=deepseek-chat

# 企业网关控制台地址（可选，供用户在客户端跳转查看/管理个人网关 Key）
# HELUO_IAM_GATEWAY_CONSOLE_URL=https://gateway.corp.example/console

# RFC 8707 resource 参数（可选，须非空）。
# 注意：IAM 6.0.3 不支持 resource 参数，请保持注释留空
# HELUO_IAM_GATEWAY_RESOURCE=

# ------------------------------------------------------------------------------
# 6. 内网 HTTP 安全开关
# ------------------------------------------------------------------------------

# 仅当确认处于受控内网且接受明文传输风险时设为 true（机密模式下会同时启用 allowInsecureClientAuthHttp）
HELUO_IAM_ALLOW_INSECURE_HTTP=false

# ------------------------------------------------------------------------------
# 7. 企业 Gitee 集成（可选，不需要时整段注释或删除）
# ------------------------------------------------------------------------------

# 企业 Gitee 主机名（可带端口，禁止包含 https:// 前缀、路径或账号密码）
HELUO_GITEE_HOST=gitee.corp.example

# Gitee CLI 可执行文件名或绝对路径（可选，禁止 URL 或 .cmd/.bat/.ps1 包装脚本）
# HELUO_GITEE_CLI_PATH=gitee

# Gitee CLI 调用超时毫秒数（可选，范围 1000-600000）
# HELUO_GITEE_TIMEOUT_MS=30000

# 允许读取的 Gitee 认证环境变量名（可选，逗号分隔，最多 8 个）
# HELUO_GITEE_AUTH_ENV=GITEE_TOKEN,HELUO_GITEE_TOKEN

# 检测到持久化明文令牌时的策略（可选）：warn | block
# HELUO_GITEE_PERSISTENT_TOKEN=warn

# ------------------------------------------------------------------------------
# 8. 敏感密钥键（默认禁止！仅作说明，切勿写入真实密钥）
# ------------------------------------------------------------------------------
# 以下两个键默认会被制包器以 BUNDLE_SECRET_EMBED_UNSUPPORTED 拒绝，密钥应由终端管理员
# 独立预置到目标机加密存储；仅在显式传入 --embed-client-secret 交付时才会读取：
# HELUO_IAM_CLIENT_SECRET=
# HELUO_IAM_CLIENT_SECRET_FILE=

# ------------------------------------------------------------------------------
# 附注：以下插件高级配置当前仅在 packages/forge-iam/src/config.mjs 支持，尚未暴露为 .env 键：
#   iamTokenHeader (默认 X-IAM-Token) / consumerTypeHeader (默认 X-Consumer-Type) /
#   consumerType (默认 personal) / exclusiveServices (默认 ['deepseekAccount'])
# ------------------------------------------------------------------------------
